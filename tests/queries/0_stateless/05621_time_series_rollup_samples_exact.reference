r, step 5m, start not a multiple of the step	(1,0,0)	1	1
r offset 30s, step 5m	(1,0,0)	1	1
r offset 5m, step 5m	(0,0,1)	1	1
r @ 3600, step 5m	(0,0,1)	1	1
r @ 3607, step 5m	(1,0,0)	1	1
sum(r), step 5m	(0,0,1)	1	1
timestamp(r), step 5m	(0,0,1)	1	1
timestamp(r offset 5m), step 5m	(0,0,1)	1	1
max_over_time(r[30m:5m]), step 5m	(0,0,1)	1	1
rate(r[5m]), step 5m	(1,0,0)	1	1
max_over_time(r[10m]), step 5m	(1,0,0)	1	1
