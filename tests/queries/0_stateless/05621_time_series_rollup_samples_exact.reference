-- the intervals are closed on the right: a sample at a multiple of the step ends its interval
[(60,2),(120,4),(121,5)]
[('1969-12-31 23:59:00.000',2),('1970-01-01 00:00:00.000',4)]
-- the intervals start over in every bucket
1970-01-01 00:00:00.000	[('1970-01-01 00:59:10.000',1)]	[('1970-01-01 00:59:10.000',1)]	[('1970-01-01 00:59:10.000',1)]
1970-01-01 01:00:00.000	[('1970-01-01 01:00:00.000',2),('1970-01-01 01:00:10.000',3)]	[('1970-01-01 01:00:00.000',2),('1970-01-01 01:00:10.000',3)]	[('1970-01-01 01:00:00.000',2),('1970-01-01 01:00:10.000',3)]
-- the last sample at or before a multiple of the step is kept: at 3600 the value is 2 with and without the rollup
[('__name__','b'),('k','v')]	[('1970-01-01 01:00:00.000',2),('1970-01-01 01:01:00.000',3)]
[('__name__','b'),('k','v')]	[('1970-01-01 01:00:00.000',2),('1970-01-01 01:01:00.000',3)]
-- every row: samples_<step> = timeSeriesGroupArray(<step>)(samples), before and after the merges
1	0	0
1	0	0
