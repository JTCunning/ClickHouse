-- after the merge each coarse interval keeps its last sample
1970-01-01 00:00:00.000	[('1970-01-01 00:00:00.000',1),('1970-01-01 00:03:20.000',6)]
1970-01-01 00:06:00.000	[('1970-01-01 00:06:40.000',7)]
1970-01-01 00:11:00.000	[('1970-01-01 00:11:40.000',8)]
-- a later sample in an old interval does not replace the kept sample
1970-01-01 00:00:00.000	[('1970-01-01 00:00:00.000',1),('1970-01-01 00:03:20.000',6)]
1970-01-01 00:06:00.000	[('1970-01-01 00:06:40.000',7)]
1970-01-01 00:11:00.000	[('1970-01-01 00:11:40.000',8)]
