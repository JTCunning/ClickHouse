-- definition of the tags table
id	Tuple(UInt64, LowCardinality(UUID))
metric_name	LowCardinality(String)
tags	Map(LowCardinality(String), String)
bucket	DateTime64(3)
ReplacingMergeTree PARTITION BY bucket PRIMARY KEY metric_name ORDER BY (metric_name, id) SETTINGS index_granularity = 8192
ts_1d	version = 14	tags_bucket_step_seconds = 86400
ts_4d	version = 14	tags_bucket_step_seconds = 345600
